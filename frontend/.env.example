# Copy thành .env.local rồi chỉnh giá trị.

# Địa chỉ backend FastAPI (không kèm /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Nhóm API gọi backend thật, cách nhau bởi dấu phẩy; nhóm không liệt kê dùng mock (lib/mocks).
# Các nhóm: auth, me, notifications, overview, cv, gap, optimizer, interview, feedback, sharing, settings, advisor, messages
# Bật "auth" thì Đăng nhập / Đăng ký dùng tài khoản thật (cookie phiên). Trang trong app luôn yêu cầu đăng nhập,
# kể cả tài khoản demo (nút "Dùng thử bản demo" chỉ điền sẵn email và mật khẩu).
# "all" = gọi backend cho tất cả. Để trống = toàn bộ mock.
NEXT_PUBLIC_LIVE_APIS=

# Chức năng chưa làm xong, mặc định tắt (xem lib/features.ts)
NEXT_PUBLIC_FEATURE_DRIVE_IMPORT=false
# Vai trò cố vấn (chia sẻ, nhắn tin, nhận xét, phân công) đang tạm ẩn; bật lại kèm ADVISOR_FEATURES=true ở backend
NEXT_PUBLIC_FEATURE_ADVISOR=false
# Nút "Dùng thử bản demo" ở trang Đăng nhập
NEXT_PUBLIC_FEATURE_DEMO_TRY=false

# Kịch bản mock: empty (mặc định, SV demo chưa có dữ liệu) | sample (SV demo có sẵn CV, phân tích, phỏng vấn để xem thiết kế)
NEXT_PUBLIC_MOCK_SCENARIO=empty

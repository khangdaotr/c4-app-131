# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration (Groq / OpenRouter / OpenAI / DeepSeek / Gemini) ----
# Lựa chọn provider: "groq", "openrouter", "openai" hoặc "deepseek"
# Key để trống = không gọi LLM, agent dùng quy tắc dự phòng (rule-based fallback).
LLM_PROVIDER=groq

# Điền API key tương ứng với provider bạn chọn:
# GROQ_API_KEY còn dùng cho trả lời phỏng vấn bằng giọng nói (Groq Whisper), kể cả khi LLM_PROVIDER khác groq.
# Không có key Groq thật thì phòng phỏng vấn ẩn nút "Nói câu trả lời", chỉ gõ.
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
DEEPSEEK_API_KEY=

# Model name:
# - Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-120b
# - OpenRouter: meta-llama/llama-3.3-70b-instruct, qwen/qwen-2.5-72b-instruct
# - OpenAI: gpt-4o-mini, gpt-4o
# - Gemini: gemini-2.5-flash, gemini-2.5-flash-lite (xem cấu hình Gemini bên dưới)
MODEL_NAME=openai/gpt-oss-120b
LLM_TEMPERATURE=0.7
# Chỉ áp cho model có suy luận (openai/gpt-oss-*, o-series, gpt-5): low / medium / high. "low" để JSON không bị cắt.
LLM_REASONING_EFFORT=low
LLM_BASE_URL=https://api.groq.com/openai/v1

# Dùng Gemini (Google AI Studio) qua endpoint tương thích OpenAI:
# lấy key tại https://aistudio.google.com/apikey rồi đặt 4 biến như sau.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=<gemini_api_key>
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# MODEL_NAME=gemini-2.5-flash

# ---- LangSmith Tracing (AI Logs — Deliverable #4) ----
# Chỉ bật (true) khi đã có LANGCHAIN_API_KEY thật; key mẫu sẽ gây lỗi 403 liên tục trong log.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_pt_your_langsmith_api_key_here
LANGCHAIN_PROJECT=ai20k-p131
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ---- App Config ----
APP_NAME="Trợ lý nghề nghiệp X"
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Mẫu tên miền được tin thêm, chỉ khi cần bản preview Vercel; để trống khi chạy máy cá nhân và khi chỉ dùng bản chính.
# Phải neo vào đuôi tên nhóm Vercel (xem src/config.py), ví dụ:
# CORS_ORIGIN_REGEX=^https://c4-app-131-(git-[a-z0-9-]+|[a-z0-9]+)-ten-nhom\.vercel\.app$
CORS_ORIGIN_REGEX=

# ---- Verified authentication ----
# Required in production: a random secret with at least 32 bytes. Blank in development
# uses an ephemeral random key, so restarting the backend invalidates existing cookies.
AUTH_SECRET_KEY=
AUTH_SESSION_TTL_SECONDS=28800
# Optional development seed password overrides (existing hashes are never reset).
# Default development-only passwords are documented in src/db/seed.py.
SEED_STUDENT_A_PASSWORD=
SEED_STUDENT_B_PASSWORD=
SEED_ADVISOR_PASSWORD=

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---- File uploads (CV gốc của sinh viên) ----
UPLOAD_DIR=./data/uploads
# Tạo nhóm SV giả định (dữ liệu minh hoạ) khi khởi động. Đang tắt: trang Quản trị chỉ hiện dữ liệu thật
# (true/false; code tạo dữ liệu vẫn giữ ở src/db/demo_cohort.py)
SEED_DEMO_COHORT=false
# Vai trò cố vấn đang tạm ẩn: tài khoản cố vấn không đăng nhập được (bật lại kèm NEXT_PUBLIC_FEATURE_ADVISOR=true)
ADVISOR_FEATURES=false

# ---- Tài khoản ----
# Vào bằng header X-Demo-Role thay cho đăng nhập: chỉ dùng cho test tự động (frontend luôn đăng nhập)
DEMO_LOGIN_ENABLED=false
# Mật khẩu của 2 tài khoản demo (sinh viên minhanh.nguyen@gmail.com chưa có dữ liệu;
# cố vấn nam.tran@careerv.vn phụ trách nhóm SV mẫu + SV demo); để trống để tắt
DEMO_ACCOUNT_PASSWORD=careerv123
# Tài khoản quản trị khi deploy (APP_ENV=production không tạo tài khoản demo). Đặt trên server, không ghi vào Git.
# Chưa có tài khoản với email này thì tạo; đã có thì giữ nguyên, không đổi mật khẩu. Mật khẩu ≥ 8 ký tự, có chữ và số.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Bật khi chạy qua HTTPS
SESSION_COOKIE_SECURE=false
SESSION_DAYS=30
# Link đặt lại mật khẩu trong email trỏ về đây
# Khi deploy: FRONTEND_URL=https://c4-app-131.vercel.app (backend tin địa chỉ này cho CORS và kiểm tra nguồn)
FRONTEND_URL=http://localhost:3000
# SMTP gửi email đặt lại mật khẩu. Để trống SMTP_HOST thì chỉ ghi link vào log backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=CareerV <no-reply@careerv.vn>

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Qdrant:
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Frontend (Next.js) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Local privacy (T1.3) ----
PII_MASKING_ENABLED=true
# Generate a Fernet key locally; store it in .env or a secret manager, never Git.
PII_VAULT_KEY=
PII_VAULT_TTL_HOURS=24
PII_MASK_ENTITY_TYPES=["PERSON","EMAIL","PHONE","ID","URL","HANDLE","DOB","ADDRESS"]
PII_KEEP_ENTITY_TYPES=["EMPLOYER","SCHOOL","JOB_TITLE","SKILL","PROJECT","EMPLOYMENT_DATE","CITY","COUNTRY"]
PII_NER_BACKEND=underthesea
PII_NER_CPU_THREADS=2
PII_SPACY_MODEL=xx_ent_wiki_sm
# PhoBERT is an explicitly provisioned local directory; no runtime downloads.
PII_PHOBERT_MODEL_DIR=
PII_OCR_COMMAND=tesseract
PII_OCR_DPI=200
PII_OCR_TIMEOUT_SECONDS=30
PII_DOCUMENT_MAX_BYTES=20000000
PII_DOCUMENT_MAX_PAGES=30

# ---- Assistant v2 raw LlmClient (T1.5) ----
# Set the shared LLM_BASE_URL above to https://api.deepseek.com for DeepSeek.
# The v2 client uses LLM_API_KEY directly, without legacy credential fallback.
LLM_API_KEY=
LLM_MODEL_AGENT=deepseek-flash
LLM_MODEL_ROUTER=deepseek-flash
LLM_THINKING_AGENT=disabled
LLM_REASONING_EFFORT=high
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
ROUTER_BACKEND=deepseek
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_CONFIRM_TTL_MIN=30
UI_ACK_TIMEOUT_S=5
USER_DAILY_TOKEN_CAP=100000
TRACE_BACKEND=none
WORKERS=1
# Deployment tariffs: leave unset when unknown; no prices are guessed.
# PROVIDER_INPUT_USD_PER_MILLION=
# PROVIDER_OUTPUT_USD_PER_MILLION=

# Guide-only how-to retrieval and in-process answer cache (single worker).
# Keep citation ranking unchanged; apply the semantic gate to unboosted E5 confidence.
RAG_ABSTAIN_THRESHOLD=0.42
RAG_SEMANTIC_ABSTAIN_THRESHOLD=0.85
RAG_UI_THRESHOLD=0.65
RAG_ANSWER_CACHE_TTL_S=300
RAG_ANSWER_CACHE_MAXSIZE=256
ASSISTANT_TZ=Asia/Ho_Chi_Minh
# Batch partial chat persistence; completion, cancellation and errors always flush.
ASSISTANT_STREAM_CHECKPOINT_SECONDS=0.5
